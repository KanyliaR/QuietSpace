DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=sound_monitoring
PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
# Opt in explicitly only when running npm run seed:demo locally.
ENABLE_DEMO_ACCOUNTS=false
# For sound.py only; each device has its own room-bound key.
QUIETSPACE_URL=http://localhost:3000
QUIETSPACE_DEVICE_KEY=
QUIETSPACE_ROOM_ID=1

# Only for the staff:create command; supply a unique password via the environment.
QUIETSPACE_STAFF_PASSWORD=

# Calendar day used by the escalation evidence picker.
LIBRARY_TIME_ZONE=America/New_York

# Temporary local testing: all stored reports. Set today to restore day filtering.
# Production defaults to today when this variable is omitted.
MONITOR_REPORT_SCOPE=all

# Staff invitation links: match the actual local PORT, or the production HTTPS origin.
APP_BASE_URL=http://localhost:3000
# Brevo transactional email API key and verified sender; placeholders only.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=your-verified-sender@example.com
# Only used by the isolated manual test script, never staff invitations.
BREVO_TEST_RECIPIENT=your-authorized-test-recipient@example.com
